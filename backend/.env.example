# ---------------------------------------------------------------------------
# VisualBoard backend — environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# HTTP
PORT=8000

# PostgreSQL (optionally DATABASE_URL_TEST for the test suite)
DATABASE_URL="postgresql://user:password@localhost:5432/visualboard"
# DATABASE_URL_TEST="postgresql://user:password@localhost:5432/visualboard_test"

# JWT: must be at least 32 characters. Use a long random string in production.
# The dev placeholder below is accepted by env validation ONLY in non-production mode.
JWT_SECRET="dev-only-change-me-please-use-a-long-random-secret"
# JWT_EXPIRES_IN=7d

# Bcrypt cost (4-15; default 10)
# BCRYPT_SALT_ROUNDS=10

# Redis (optional: app degrades gracefully when unavailable)
# Set to "" or "disabled" to turn Redis off entirely (no connection attempts).
REDIS_URL="redis://localhost:6379"
# REDIS_ADAPTER=false

# Logging
# LOG_LEVEL=info

# CORS: comma-separated list of allowed origins
FRONTEND_ORIGIN="http://localhost:5174,http://localhost:5175"

# File storage: "local" (default) or "s3"
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./uploads

# S3-compatible storage (only when STORAGE_DRIVER=s3)
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# AI suggestions (Groq). Optional; the suggestions endpoint returns 503 when unset.
# GROQ_API_KEY=
# GROQ_API_URL=https://api.groq.dev/v1/generate
# GROQ_MODEL=openai/gpt-oss-120b

# Rate limiting (requests per window)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_WRITE_MAX=200
# RATE_LIMIT_WINDOW_MS=900000

# OAuth providers (optional). Enabled at runtime only when all values are set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=