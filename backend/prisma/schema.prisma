generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  editor
  viewer
}

model board_members {
  id         Int       @id(map: "board_members_pkey") @default(autoincrement())
  user_id    Int
  board_id   Int
  role       Role      @default(viewer)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  boards     boards    @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_board")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_user")

  @@unique([user_id, board_id], map: "unique_board_member")
  @@index([board_id], map: "idx_members_board")
  @@index([user_id], map: "idx_members_user")
}

model boards {
  id            Int             @id @default(autoincrement())
  title         String          @db.VarChar(255)
  description   String?
  owner_id      Int
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @updatedAt @db.Timestamp(6)
  board_members board_members[]
  users         users           @relation(fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_board_owner")
  comments      comments[]
  documents     documents[]
  elements      elements[]
  versions      versions[]

  @@index([owner_id], map: "idx_boards_owner")
}

model comments {
  id         Int       @id @default(autoincrement())
  board_id   Int
  user_id    Int
  content    String    @db.VarChar(2000)
  element_id String?
  x_position Float?
  y_position Float?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  boards     boards    @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_board")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_user")

  @@index([board_id], map: "idx_comments_board")
  @@index([user_id], map: "idx_comments_user")
}

model documents {
  id            Int       @id @default(autoincrement())
  board_id      Int
  element_id    String?
  user_id       Int
  original_name String    @db.VarChar(255)
  stored_name   String    @unique @db.VarChar(255)
  mime_type     String    @db.VarChar(120)
  size          Int
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  boards        boards    @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_board")
  elements      elements? @relation(fields: [element_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_doc_element")
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_user")

  @@index([board_id], map: "idx_documents_board")
  @@index([element_id], map: "idx_documents_element")
  @@index([user_id], map: "idx_documents_user")
}

model elements {
  id           String      @id @db.VarChar(64)
  board_id     Int
  element_data Json
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  updated_at   DateTime?   @default(now()) @updatedAt @db.Timestamp(6)
  boards       boards      @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_element_board")
  documents    documents[]

  @@index([board_id], map: "idx_elements_board")
}

model users {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  email         String          @unique @db.VarChar(255)
  password      String?         @db.VarChar(255)
  avatar        String?
  provider      String?         @db.VarChar(20)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @updatedAt @db.Timestamp(6)
  board_members board_members[]
  boards        boards[]
  comments      comments[]
  documents     documents[]
  versions      versions[]

  @@index([email], map: "idx_users_email")
}

model versions {
  id         Int       @id @default(autoincrement())
  board_id   Int
  snapshot   Json
  created_by Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  boards     boards    @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_version_board")
  users      users     @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_version_user")

  @@index([board_id], map: "idx_versions_board")
  @@index([created_by], map: "idx_versions_user")
}
